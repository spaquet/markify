    "Remove selected folder from search" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewählten Ordner aus der Suche entfernen"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar la carpeta seleccionada de la búsqueda"
          }
        },
