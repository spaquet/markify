        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight potrebbe ancora elaborare le note inviate. Prova un’altra frase o un ambito più ampio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Spotlight pode ainda estar a processar as notas enviadas. Experimente outra expressão ou um âmbito mais amplo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
