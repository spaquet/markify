    "Helps us find and fix crashes and slow spots. Takes effect at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilft uns, Abstürze und langsame Stellen zu finden und zu beheben. Wird sofort wirksam."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos ayuda a detectar y corregir fallos y problemas de rendimiento. Se aplica de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
