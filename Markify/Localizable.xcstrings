    "Allows Spotlight to find related meaning when available on this Mac. Related results open at the top of the note." : {
      "localizations" : {
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Spotlight encuentre resultados con un significado relacionado si esta función está disponible en este Mac. Estos resultados se abren al principio de la nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à Spotlight de trouver des résultats de sens proche si cette fonction est disponible sur ce Mac. Ces résultats s’ouvrent au début de la note."
          }
        }
      }
    },
