        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Participez au programme d’envoi de rapports. Nous recevons les informations sur les plantages et les lenteurs pour les corriger plus vite, sans aucune donnée personnelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
