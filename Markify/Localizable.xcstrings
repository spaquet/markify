    "The listing is rebuilt from each concept’s type, title and description. Anything written by hand in index.md is replaced." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste wird aus Typ, Titel und Beschreibung jedes Konzepts neu erstellt. Alles, was von Hand in index.md geschrieben wurde, wird ersetzt."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista se reconstruye a partir del tipo, el título y la descripción de cada concepto. Todo lo escrito a mano en index.md se reemplaza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luettelo rakennetaan uudelleen jokaisen käsitteen tyypin, otsikon ja kuvauksen perusteella. Index.md-tiedostoon käsin kirjoitettu sisältö korvataan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste est reconstruite à partir du type, du titre et de la description de chaque concept. Tout ce qui a été écrit à la main dans index.md est remplacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’elenco viene ricreato da tipo, titolo e descrizione di ogni concetto. Tutto ciò che è stato scritto a mano in index.md viene sostituito."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listen bygges på nytt fra hvert konsepts type, tittel og beskrivelse. Alt som er skrevet manuelt i index.md, erstattes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lista é reconstruída a partir do tipo, título e descrição de cada conceito. Tudo o que foi escrito à mão em index.md é substituído."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listan byggs om från varje koncepts typ, titel och beskrivning. Allt som skrivits för hand i index.md ersätts."
          }
        }
      }
    },
    "The on-device model is downloading. Features turn on when it's ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell auf dem Gerät wird geladen. Die Funktionen werden aktiviert, sobald es bereit ist."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo en el dispositivo se está descargando. Las funciones se activan cuando esté listo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteen mallia ladataan. Ominaisuudet otetaan käyttöön, kun se on valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle sur l’appareil est en cours de téléchargement. Les fonctionnalités s’activent dès qu’il est prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello sul dispositivo è in download. Le funzioni si attivano quando è pronto."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellen på enheten lastes ned. Funksjonene slås på når den er klar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo no dispositivo está a ser descarregado. As funcionalidades ativam-se quando estiver pronto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellen på enheten laddas ned. Funktionerna aktiveras när den är klar."
          }
        }
      }
    },
    "The selection changed while writing. Generate again to avoid replacing newer edits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auswahl hat sich beim Schreiben geändert. Generiere erneut, um neuere Änderungen nicht zu ersetzen."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selección ha cambiado mientras se escribía. Vuelve a generar para no reemplazar ediciones más recientes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valinta muuttui kirjoituksen aikana. Luo uudelleen, jotta et korvaa uudempia muokkauksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection a changé pendant l’écriture. Générez à nouveau pour ne pas remplacer des modifications plus récentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selezione è cambiata durante la scrittura. Genera di nuovo per non sostituire modifiche più recenti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeringen endret seg mens du skrev. Generer på nytt for å unngå å erstatte nyere redigeringer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seleção mudou durante a escrita. Gere novamente para não substituir edições mais recentes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeringen ändrades medan du skrev. Generera igen för att inte ersätta nyare ändringar."
          }
        }
      }
    },
    "The server redirected to a different origin. Credentials were not sent. Open the destination separately if you trust it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat zu einem anderen Ursprung umgeleitet. Es wurden keine Anmeldedaten gesendet. Öffne das Ziel separat, wenn du ihm vertraust."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha redirigido a otro origen. No se han enviado las credenciales. Abre el destino por separado si confías en él."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin ohjasi toiseen alkuperään. Tunnistetietoja ei lähetetty. Avaa kohde erikseen, jos luotat siihen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a redirigé vers une autre origine. Les identifiants n’ont pas été envoyés. Ouvrez la destination séparément si vous lui faites confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
