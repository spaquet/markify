    "Join the Program" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Programm teilnehmen"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
