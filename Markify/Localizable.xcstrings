    "Its folder may have been removed or need access. Check Settings › Search." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner wurde möglicherweise entfernt oder benötigt Zugriff. Überprüfe „Einstellungen“ › „Suchen“."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que su carpeta se haya eliminado o necesite acceso. Revisa Ajustes › Búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son dossier a peut-être été supprimé ou nécessite un accès. Vérifiez Réglages › Recherche."
          }
        },
        "it" : {
          "stringUnit" : {
