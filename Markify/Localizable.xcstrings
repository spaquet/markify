    "Removes Markify’s search entries and pauses indexing until you rebuild. Your files and macOS’s independent file index are untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt die Sucheinträge von Markify und pausiert die Indexierung, bis du sie neu erstellst. Deine Dateien und der unabhängige Dateiindex von macOS bleiben unberührt."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las entradas de búsqueda de Markify y pausa la indexación hasta que reconstruyas el índice. Tus archivos y el índice independiente de macOS no se modifican."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa Markifyn hakumerkinnät ja keskeyttää indeksoinnin, kunnes rakennat sen uudelleen. Tiedostosi ja macOS:n oma tiedostohakemisto pysyvät ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les entrées de recherche de Markify et suspend l’indexation jusqu’à sa reconstruction. Vos fichiers et l’index indépendant de macOS restent intacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove le voci di ricerca di Markify e sospende l’indicizzazione finché non ricrei l’indice. I tuoi file e l’indice dei file indipendente di macOS restano intatti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner Markifys søkeoppføringer og pauser indekseringen til du bygger den på nytt. Filene dine og macOS’ egne filindeks forblir urørt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove as entradas de pesquisa do Markify e pausa a indexação até a reconstruir. Os seus ficheiros e o índice de ficheiros independente do macOS ficam intactos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort Markifys sökposter och pausar indexeringen tills du bygger om den. Dina filer och macOS:s oberoende filindex lämnas orörda."
          }
        }
      }
    },
    "Removing a folder removes its search entries, never its files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Ordner entfernst, werden seine Sucheinträge entfernt, niemals seine Dateien."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al quitar una carpeta, se eliminan sus entradas de búsqueda, nunca sus archivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kansion poistaminen poistaa sen hakumerkinnät, ei koskaan tiedostoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer un dossier supprime ses entrées de recherche, jamais ses fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere una cartella ne rimuove le voci di ricerca, mai i file."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du fjerner en mappe, fjernes søkeoppføringene, aldri filene."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover uma pasta remove as respetivas entradas de pesquisa, nunca os ficheiros."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du tar bort en mapp tas dess sökposter bort, aldrig dess filer."
          }
        }
      }
    },
