    "System Writing Tools are available. Generation and link summaries require macOS 26 or later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schreibtools des Systems sind verfügbar. Generierung und Link-Zusammenfassungen erfordern macOS 26 oder neuer."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Herramientas de Escritura del sistema están disponibles. La generación y los resúmenes de enlaces requieren macOS 26 o posterior."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestelmän kirjoitustyökalut ovat käytettävissä. Luominen ja linkkiyhteenvedot vaativat macOS 26:n tai uudemman version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Outils d’écriture du système sont disponibles. La génération et les résumés de liens nécessitent macOS 26 ou version ultérieure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli Strumenti di scrittura di sistema sono disponibili. La generazione e i riassunti dei link richiedono macOS 26 o versione successiva."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemets skriveverktøy er tilgjengelige. Generering og oppsummering av lenker krever macOS 26 eller nyere."
