    "Join the reports program. Crashes and slow spots reach us, so we can fix them faster, and nothing personal comes with them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm am Berichtsprogramm teil. Abstürze und langsame Stellen erreichen uns, damit wir sie schneller beheben können, und nichts Persönliches wird mitgesendet."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Participa en el programa de envío de informes. Recibiremos información sobre fallos y problemas de rendimiento para corregirlos antes, sin ningún dato personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Participez au programme d’envoi de rapports. Nous recevons les informations sur les plantages et les lenteurs pour les corriger plus vite, sans aucune donnée personnelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partecipa al programma di invio dei rapporti. Riceviamo arresti anomali e rallentamenti per correggerli più in fretta, senza alcun dato personale."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adira ao programa de relatórios. As falhas e lentidões chegam até nós para as podermos corrigir mais depressa, sem nada de pessoal."
          }
        }
      }
    },
