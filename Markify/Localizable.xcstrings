    "Access to this folder expired. Its notes stay hidden until you grant access again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf diesen Ordner ist abgelaufen. Seine Notizen bleiben ausgeblendet, bis du erneut Zugriff gewährst."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El permiso de acceso a esta carpeta ha caducado. Sus notas permanecerán ocultas hasta que vuelvas a autorizar el acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation d’accès à ce dossier a expiré. Ses notes restent masquées jusqu’à ce que vous autorisiez à nouveau l’accès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso a questa cartella è scaduto. Le sue note restano nascoste finché non concedi di nuovo l’accesso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso a esta pasta expirou. As respetivas notas ficam ocultas até voltar a conceder acesso."
          }
        }
      }
    },
    "Access was denied. Choose credentials below and retry, or replace expired credentials. The server may also have reached its request limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff verweigert. Wähle unten Anmeldedaten und versuche es erneut, oder ersetze abgelaufene Anmeldedaten. Möglicherweise hat der Server auch sein Anfragelimit erreicht."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso denegado. Elige credenciales abajo y vuelve a intentarlo, o sustituye las credenciales caducadas. Es posible que el servidor también haya alcanzado su límite de solicitudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès refusé. Choisissez des identifiants ci-dessous et réessayez, ou remplacez les identifiants expirés. Le serveur a peut-être aussi atteint sa limite de requêtes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesso negato. Scegli le credenziali qui sotto e riprova, oppure sostituisci quelle scadute. Il server potrebbe anche aver raggiunto il limite di richieste."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesso negado. Escolha credenciais abaixo e tente novamente, ou substitua as credenciais expiradas. O servidor também pode ter atingido o limite de pedidos."
          }
        }
      }
    },
