    "Your notes stay on disk. Choose Rebuild Index to resume Library search." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Notizen bleiben auf dem Volume. Wähle „Index neu erstellen“, um die Bibliothekssuche fortzusetzen."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus notas permanecen en el disco. Selecciona Reconstruir índice para reanudar la búsqueda en la biblioteca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistiinpanosi pysyvät levyllä. Valitse Rakenna hakemisto uudelleen jatkaaksesi kirjaston hakua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos notes restent sur le disque. Choisissez Reconstruire l’index pour reprendre la recherche dans la bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue note restano sul disco. Scegli Ricrea indice per riprendere la ricerca nella libreria."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notatene dine blir på disken. Velg Bygg indeks på nytt for å fortsette søket i biblioteket."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As suas notas ficam no disco. Escolha Reconstruir índice para retomar a pesquisa na biblioteca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina anteckningar stannar på disken. Välj Bygg om index för att återuppta biblioteksökningen."
          }
        }
      }
    },
