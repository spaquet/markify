    "Comma-separated names, applied inside every indexed folder. Hidden files and symlinks are skipped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Kommas getrennte Namen, angewendet in jedem indexierten Ordner. Versteckte Dateien und symbolische Links werden übersprungen."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombres separados por comas que se aplican en cada carpeta indexada. Se omiten los archivos ocultos y los enlaces simbólicos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noms séparés par des virgules, pris en compte dans chaque dossier indexé. Les fichiers masqués et les liens symboliques sont ignorés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomi separati da virgole, applicati in ogni cartella indicizzata. I file nascosti e i link simbolici vengono ignorati."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomes separados por vírgulas, aplicados em todas as pastas indexadas. Os ficheiros ocultos e as ligações simbólicas são ignorados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilkuilla erotetut nimet, sovelletaan jokaiseen indeksoituun kansioon. Piilotetut tiedostot ja symboliset linkit ohitetaan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommaseparerte navn, brukes i alle indekserte mapper. Skjulte filer og symbolske lenker hoppes over."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommaseparerade namn som tillämpas i varje indexerad mapp. Dolda filer och symboliska länkar hoppas över."
          }
        }
      }
    },
