    "The listing is rebuilt from each concept’s type, title and description. Anything written by hand in index.md is replaced." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste wird aus Typ, Titel und Beschreibung jedes Konzepts neu erstellt. Alles, was von Hand in index.md geschrieben wurde, wird ersetzt."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista se reconstruye a partir del tipo, el título y la descripción de cada concepto. Todo lo escrito a mano en index.md se reemplaza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste est reconstruite à partir du type, du titre et de la description de chaque concept. Tout ce qui a été écrit à la main dans index.md est remplacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’elenco viene ricreato da tipo, titolo e descrizione di ogni concetto. Tutto ciò che è stato scritto a mano in index.md viene sostituito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lista é reconstruída a partir do tipo, título e descrição de cada conceito. Tudo o que foi escrito à mão em index.md é substituído."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luettelo rakennetaan uudelleen jokaisen käsitteen tyypin, otsikon ja kuvauksen perusteella. Index.md-tiedostoon käsin kirjoitettu sisältö korvataan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listen bygges på nytt fra hvert konsepts type, tittel og beskrivelse. Alt som er skrevet manuelt i index.md, erstattes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listan byggs om från varje koncepts typ, titel och beskrivning. Allt som skrivits för hand i index.md ersätts."
          }
        }
      }
    },
    "The on-device model is downloading. Features turn on when it's ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell auf dem Gerät wird geladen. Die Funktionen werden aktiviert, sobald es bereit ist."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo en el dispositivo se está descargando. Las funciones se activan cuando esté listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle sur l’appareil est en cours de téléchargement. Les fonctionnalités s’activent dès qu’il est prêt."
          }
        },
        "it" : {
          "stringUnit" : {
