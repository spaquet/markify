    "Shows which section contains a literal match. Headings remain part of the note’s searchable text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt, welcher Abschnitt einen wörtlichen Treffer enthält. Überschriften bleiben Teil des durchsuchbaren Texts der Notiz."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica qué sección contiene una coincidencia literal. Los encabezados siguen formando parte del texto de la nota en el que se puede buscar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää, mikä osio sisältää täsmällisen osuman. Otsikot pysyvät osana muistiinpanon haettavaa tekstiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique la section contenant une correspondance exacte. Le texte des titres reste inclus dans la recherche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica quale sezione contiene una corrispondenza esatta. I titoli restano parte del testo ricercabile della nota."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser hvilken seksjon som inneholder en eksakt treff. Overskrifter forblir en del av notatets søkbare tekst."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra que secção contém uma correspondência literal. Os cabeçalhos continuam a fazer parte do texto pesquisável da nota."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar vilket avsnitt som innehåller en exakt träff. Rubriker förblir en del av anteckningens sökbara text."
          }
        }
      }
    },
