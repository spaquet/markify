    "Spotlight may still be processing submitted notes. Try another phrase or a wider scope." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight verarbeitet eingereichte Notizen möglicherweise noch. Versuche einen anderen Ausdruck oder einen größeren Bereich."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que Spotlight aún esté procesando las notas enviadas. Prueba con otra expresión o amplía la búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight traite peut-être encore les notes transmises. Essayez une autre expression ou élargissez la recherche."
