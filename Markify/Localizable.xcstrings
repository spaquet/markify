    "Allows Spotlight to find related meaning when available on this Mac. Related results open at the top of the note." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht Spotlight, verwandte Bedeutungen zu finden, sofern auf diesem Mac verfügbar. Verwandte Treffer öffnen sich am Anfang der Notiz."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Spotlight encuentre resultados con un significado relacionado si esta función está disponible en este Mac. Estos resultados se abren al principio de la nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à Spotlight de trouver des résultats de sens proche si cette fonction est disponible sur ce Mac. Ces résultats s’ouvrent au début de la note."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente a Spotlight di trovare risultati di significato affine, se disponibile su questo Mac. Questi risultati si aprono all’inizio della nota."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o Spotlight encontre significados relacionados, quando disponível neste Mac. Os resultados relacionados abrem no início da nota."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight voi löytää tämän Macin saatavilla olevan merkityksen mukaiset liittyvät tulokset. Liittyvät tulokset avautuvat muistiinpanon yläosaan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar Spotlight finne beslektet betydning når det er tilgjengelig på denne Macen. Relaterte resultater åpnes øverst i notatet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter Spotlight hitta närliggande betydelse när det finns på den här Macen. Relaterade resultat öppnas överst i anteckningen."
          }
        }
      }
    },
    "Also available as /write in the insert menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch als /write im Einfügemenü verfügbar."
          }
        },
        "es-ES" : {
