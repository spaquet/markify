// Copy to Config/Sentry.local.xcconfig (git-ignored) to report from local builds.
// xcconfig treats // as a comment, so write the scheme's slashes as /$()/.
// Debug builds report to the "development" environment, Release builds to "production".

SENTRY_DSN = https:/$()/<public-key>@<org-id>.ingest.us.sentry.io/<project-id>
